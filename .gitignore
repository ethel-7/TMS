# ============================================================================
# TMS Repository - Unified .gitignore
# Contains ignore patterns for both TmsCore (C#) and TmsClient (TypeScript)
# ============================================================================

# ============================================================================
# DOCUMENTATION FILES (not tracked in repository)
# ============================================================================
BRANCHING_STRATEGY.md
CONTRIBUTING.md
branch.md
note.md
*.pdf

# ============================================================================
# C# / .NET (TmsCore)
# ============================================================================

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio / VS Code
.vs/
.vscode/
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build outputs
*.dll
*.exe
*.pdb
*.cache

# NuGet
*.nupkg
*.snupkg
packages/
project.lock.json
project.fragment.lock.json

# ============================================================================
# TypeScript / Node.js (TmsClient)
# ============================================================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Compiled outputs
dist/
build/
*.js
*.js.map
*.d.ts
*.d.ts.map

# Keep important entry files
!TmsClient/index.js
!TmsClient/index.d.ts

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage/
.nyc_output/

# Logs
logs/
*.log

# ============================================================================
# IDE and OS
# ============================================================================
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================================================================
# Git
# ============================================================================
*.orig
